#cloud-config
manage_resolv_conf: false

hostname: "edgeinspect"
manage_etc_hosts: true
packages:
- avahi-daemon
apt:
  preserve_sources_list: true
  conf: |
    Acquire {
      Check-Date "false";
    };
timezone: "Asia/Kolkata"
keyboard:
  model: pc105
  layout: "us"
user:
  name: "edgeuser"
  shell: /bin/bash
  lock_passwd: false
  passwd: "<YOUR_PASSWORD_HASH>"
  sudo: null
ssh_pwauth: true
runcmd:
  - [ systemctl, enable, --now, ssh ]
