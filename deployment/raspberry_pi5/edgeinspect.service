[Unit]
Description=EdgeInspect AI - Industrial Defect Detection & Quality Control
After=network.target

[Service]
Type=simple
User=edgeuser
WorkingDirectory=/home/edgeuser/edgeinspect
ExecStart=/home/edgeuser/edgeinspect/.venv/bin/streamlit run app.py --server.port 8501 --server.headless true --server.address 0.0.0.0
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
